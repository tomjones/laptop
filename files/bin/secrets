#!/usr/bin/env bash
# secrets — a small front end over sops + age for local development secrets.
#
#   secrets init                     provision identities and ~/.sops.yaml
#   secrets unlock                   cache the decrypted identity for this boot
#   secrets lock                     wipe the cached identity now
#   secrets status                   what is provisioned, what is unlocked
#   secrets list                     projects in the store
#   secrets import <proj> <envfile>  encrypt an existing .env into the store
#   secrets edit <proj>              open the decrypted file in $EDITOR
#   secrets names <proj>             list variable NAMES only (never values)
#   secrets cat <proj>               print decrypted contents (think first)
#   secrets add-fido2                enrol a security key as an extra recipient
#   secrets <proj> -- <cmd...>       run cmd with the project's secrets in env
#
# The store is ~/.secrets/<project>.env, SOPS-encrypted with age. Variable names
# stay readable so diffs remain meaningful; only values are encrypted.
#
# age encrypts to multiple recipients and ANY ONE of them decrypts. That is what
# makes "unlock with a passphrase OR a security key" possible — they are two
# recipients on the same file, not two factors.

set -uo pipefail

STORE="${SECRETS_DIR:-$HOME/.secrets}"
AGE_DIR="$HOME/.config/age"
IDENTITY_ENC="$AGE_DIR/identity.age"
RECIPIENTS="$AGE_DIR/recipients.txt"
SOPS_CONFIG="$HOME/.sops.yaml"
CACHE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
CACHE="$CACHE_DIR/age-identity.txt"

if [[ -t 1 ]]; then
  R=$'\033[0m'; B=$'\033[1m'; DIM=$'\033[2m'
  RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'
else
  R=""; B=""; DIM=""; RED=""; GRN=""; YEL=""
fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$GRN" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$YEL" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed. Run: ~/laptop/setup.sh secrets"; }

usage() { sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; }

# ------------------------------------------------------------------ init ----

cmd_init() {
  need age; need age-keygen; need sops

  mkdir -p "$AGE_DIR" "$STORE"
  chmod 700 "$AGE_DIR" "$STORE"

  if [[ -f "$IDENTITY_ENC" ]]; then
    die "$IDENTITY_ENC already exists. Delete it first if you really mean to start over — every existing secret becomes unreadable."
  fi

  say "${B}1/3  Daily identity${R}"
  say "Choose a strong passphrase. It protects the key file, and it is one of"
  say "the two ways you will unlock your secrets."
  say ""

  local tmp pub
  tmp="$(mktemp)"; chmod 600 "$tmp"
  age-keygen -o "$tmp" 2>/dev/null || { rm -f "$tmp"; die "age-keygen failed"; }
  pub="$(grep '^# public key: ' "$tmp" | cut -d' ' -f4)"

  if ! age -p -o "$IDENTITY_ENC" < "$tmp"; then
    rm -f "$tmp"; die "failed to encrypt the identity file"
  fi
  chmod 600 "$IDENTITY_ENC"
  rm -f "$tmp"
  printf '%s\n' "$pub" > "$RECIPIENTS"
  chmod 600 "$RECIPIENTS"
  ok "daily identity created — public key: $pub"

  say ""
  say "${B}2/3  Paper recovery key${R}"
  say "This is your last line of defence. If you lose the passphrase AND any"
  say "security key, this is the only thing that can still decrypt your secrets."
  say "It is deliberately never written to disk."
  say ""
  local paper_tmp paper_pub
  paper_tmp="$(mktemp)"; chmod 600 "$paper_tmp"
  age-keygen -o "$paper_tmp" 2>/dev/null || { rm -f "$paper_tmp"; die "age-keygen failed"; }
  paper_pub="$(grep '^# public key: ' "$paper_tmp" | cut -d' ' -f4)"

  printf '%s\n' "$YEL================ PRINT THIS AND STORE IT OFFLINE ================$R"
  grep -v '^#' "$paper_tmp"
  printf '%s\n' "$YEL================================================================$R"
  printf '%s\n' "$paper_pub" >> "$RECIPIENTS"
  shred -u "$paper_tmp" 2>/dev/null || rm -f "$paper_tmp"

  say ""
  read -r -p "Type 'saved' once it is printed or written down somewhere safe: " confirm
  [[ "$confirm" == "saved" ]] || warn "Not confirmed. The key above is gone from this machine — recover it from your scrollback now, or re-run init."

  say ""
  say "${B}3/3  sops configuration${R}"
  write_sops_config
  ok "wrote $SOPS_CONFIG"

  say ""
  ok "Store ready at $STORE"
  say "Next:  secrets import <project> path/to/.env"
  say "Then:  secrets <project> -- npm run dev"
}

write_sops_config() {
  local recipients
  recipients="$(grep -v '^\s*$' "$RECIPIENTS" | paste -sd, -)"
  cat > "$SOPS_CONFIG" <<EOF
# Managed by 'secrets'. Every recipient below can independently decrypt.
creation_rules:
  - path_regex: \\.secrets/.*\\.env\$
    key_groups:
      - age:
$(grep -v '^\s*$' "$RECIPIENTS" | sed 's/^/          - /')
  - path_regex: \\.enc\\.(env|ya?ml|json)\$
    age: ${recipients}
EOF
  chmod 600 "$SOPS_CONFIG"
}

# ---------------------------------------------------------- unlock / lock ----

cmd_unlock() {
  need age
  [[ -f "$IDENTITY_ENC" ]] || die "no identity. Run: secrets init"
  if [[ -s "$CACHE" ]]; then ok "already unlocked"; return 0; fi
  mkdir -p "$CACHE_DIR"
  ( umask 077; age -d "$IDENTITY_ENC" > "$CACHE" ) || { rm -f "$CACHE"; die "decryption failed"; }
  chmod 600 "$CACHE"
  ok "unlocked — cached in $CACHE (tmpfs; cleared on reboot)"
}

cmd_lock() {
  if [[ -e "$CACHE" ]]; then
    shred -u "$CACHE" 2>/dev/null || rm -f "$CACHE"
    ok "locked"
  else
    say "already locked"
  fi
}

# Ensure an identity is available, unlocking on demand.
ensure_key() {
  [[ -s "$CACHE" ]] && { export SOPS_AGE_KEY_FILE="$CACHE"; return 0; }
  [[ -f "$IDENTITY_ENC" ]] || die "no identity. Run: secrets init"
  cmd_unlock >&2 || exit 1
  export SOPS_AGE_KEY_FILE="$CACHE"
}

cmd_status() {
  printf '%-22s %s\n' "store"      "$STORE $( [[ -d $STORE ]] && echo "(exists)" || echo "${RED}(missing)${R}" )"
  printf '%-22s %s\n' "identity"   "$( [[ -f $IDENTITY_ENC ]] && echo "${GRN}provisioned${R}" || echo "${RED}not provisioned${R}" )"
  printf '%-22s %s\n' "unlocked"   "$( [[ -s $CACHE ]] && echo "${GRN}yes${R} (until reboot)" || echo "no" )"
  printf '%-22s %s\n' "recipients" "$( [[ -f $RECIPIENTS ]] && grep -c . "$RECIPIENTS" || echo 0 )"
  if [[ -f "$RECIPIENTS" ]]; then
    sed 's/^/                       /' "$RECIPIENTS"
  fi
  printf '%-22s %s\n' "projects"   "$(ls -1 "$STORE"/*.env 2>/dev/null | wc -l)"
}

cmd_list() {
  [[ -d "$STORE" ]] || die "no store at $STORE"
  local f n=0
  for f in "$STORE"/*.env; do
    [[ -e "$f" ]] || continue
    printf '  %s\n' "$(basename "$f" .env)"; n=$((n+1))
  done
  ((n)) || say "  ${DIM}(empty — use 'secrets import <project> <envfile>')${R}"
}

# ---------------------------------------------------------------- import ----

cmd_import() {
  local project="${1:-}" src="${2:-}"
  [[ -n "$project" && -n "$src" ]] || die "usage: secrets import <project> <envfile>"
  [[ -f "$src" ]] || die "no such file: $src"
  [[ -f "$SOPS_CONFIG" ]] || die "no sops config. Run: secrets init"
  need sops
  local dest="$STORE/$project.env"
  [[ -e "$dest" ]] && die "$dest already exists"
  mkdir -p "$STORE"; chmod 700 "$STORE"
  cp "$src" "$dest"
  if sops --encrypt --input-type dotenv --output-type dotenv --in-place "$dest"; then
    chmod 600 "$dest"
    ok "imported $src -> $dest"
    say ""
    say "Now verify, then remove the plaintext original:"
    say "  ${DIM}secrets names $project${R}"
    say "  ${DIM}shred -u $src${R}"
  else
    rm -f "$dest"
    die "encryption failed"
  fi
}

cmd_edit() {
  local project="${1:-}"
  [[ -n "$project" ]] || die "usage: secrets edit <project>"
  need sops; ensure_key
  exec sops --input-type dotenv --output-type dotenv "$STORE/$project.env"
}

cmd_names() {
  local project="${1:-}"
  [[ -n "$project" ]] || die "usage: secrets names <project>"
  [[ -f "$STORE/$project.env" ]] || die "unknown project: $project"
  # Variable names are not encrypted, so this needs no key at all.
  grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$STORE/$project.env" | tr -d '='
}

cmd_cat() {
  local project="${1:-}"
  [[ -n "$project" ]] || die "usage: secrets cat <project>"
  need sops; ensure_key
  sops --decrypt --input-type dotenv --output-type dotenv "$STORE/$project.env"
}

# ------------------------------------------------------------- add-fido2 ----

cmd_add_fido2() {
  need age
  command -v age-plugin-fido2-hmac >/dev/null 2>&1 \
    || die "age-plugin-fido2-hmac is not installed. Run: ENABLE_FIDO2=1 ~/laptop/setup.sh secrets"
  [[ -d /dev/bus/usb ]] \
    || warn "no USB passthrough visible. Under WSL: 'winget install usbipd' on Windows, then 'usbipd bind --busid <id>' once and 'usbipd attach --wsl --busid <id>'."

  say "Touch your security key when it flashes."
  local out pub
  out="$(age-plugin-fido2-hmac --generate 2>&1)" || die "enrolment failed:\n$out"
  pub="$(printf '%s\n' "$out" | grep -oE 'age1[a-z0-9]+' | head -1)"
  [[ -n "$pub" ]] || { printf '%s\n' "$out"; die "could not parse a recipient from the plugin output"; }

  printf '%s\n' "$pub" >> "$RECIPIENTS"
  write_sops_config
  ok "security key added as a recipient: $pub"

  say ""
  say "Re-encrypting existing secrets so the key works on them too..."
  ensure_key
  local f
  for f in "$STORE"/*.env; do
    [[ -e "$f" ]] || continue
    if sops updatekeys --yes "$f" >/dev/null 2>&1; then
      ok "  $(basename "$f")"
    else
      warn "  $(basename "$f") — updatekeys failed, re-encrypt it by hand"
    fi
  done
}

# ------------------------------------------------------------------- run ----

cmd_run() {
  local project="$1"; shift
  [[ "${1:-}" == "--" ]] && shift
  (($#)) || die "usage: secrets <project> -- <command...>"
  local file="$STORE/$project.env"
  [[ -f "$file" ]] || die "unknown project '$project'. Try: secrets list"
  need sops; ensure_key
  # sops exec-env takes the command as a single string.
  exec sops exec-env --input-type dotenv "$file" "$(printf '%q ' "$@")"
}

# ---------------------------------------------------------------- dispatch --

case "${1:-}" in
  ""|-h|--help|help) usage ;;
  init)        shift; cmd_init "$@" ;;
  unlock)      shift; cmd_unlock "$@" ;;
  lock)        shift; cmd_lock "$@" ;;
  status)      shift; cmd_status "$@" ;;
  list|ls)     shift; cmd_list "$@" ;;
  import)      shift; cmd_import "$@" ;;
  edit)        shift; cmd_edit "$@" ;;
  names)       shift; cmd_names "$@" ;;
  cat)         shift; cmd_cat "$@" ;;
  add-fido2)   shift; cmd_add_fido2 "$@" ;;
  *)           cmd_run "$@" ;;
esac
